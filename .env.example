# Copy this file to .env for local development.
# Generate a strong value, for example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value

# development or production
APP_ENV=development

# Optional overrides
# DATABASE_PATH=C:/absolute/path/to/recruitment.db
# CSRF_ENABLED=true
# SESSION_COOKIE_SECURE=false
